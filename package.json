{
  "name": "quest-map-sf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "dev:static": "STATIC=1 vite",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "deploy": "npm run typecheck && npm run build:api && vercel deploy --prod --yes"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@types/three": "^0.187.0",
    "@vapi-ai/web": "^3.1.0",
    "exa-js": "^2.28.0",
    "hono": "^4.13.17",
    "mapbox-gl": "^3.34.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
